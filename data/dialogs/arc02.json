{
 "dialogs": [
  {
   "id": "dlg_a02_d011",
   "npc": "npc_proctor",
   "start": "n1",
   "nodes": {
    "n1": {
     "speaker": "npc:npc_proctor",
     "text": "Ujian tengah semester dimulai. Perlihatkan apa yang telah kau pelajari — satu ronde, aturan standar.",
     "choices": [
      {
       "label": "Aku siap.",
       "next": "n2"
      }
     ]
    },
    "n2": {
     "speaker": "npc:npc_proctor",
     "text": "Bagus. Mulai!",
     "choices": []
    }
   }
  },
  {
   "id": "dlg_a02_d012",
   "npc": "npc_proctor",
   "start": "n1",
   "nodes": {
    "n1": {
     "speaker": "npc:npc_proctor",
     "text": "Ujian kelompok — bukan soal siapa terkuat, tapi bagaimana kalian bertarung bersama. Aku akan menguji kalian.",
     "choices": [
      {
       "label": "Kami siap bersama.",
       "next": "n2"
      }
     ]
    },
    "n2": {
     "speaker": "npc:npc_proctor",
     "text": "Tunjukkan kerja samamu. Mulai!",
     "choices": []
    }
   }
  },
  {
   "id": "dlg_a02_d013",
   "npc": "npc_lin_yue",
   "start": "n1",
   "nodes": {
    "n1": {
     "speaker": "npc:npc_lin_yue",
     "text": "Kau sudah membaca catatannya. 'Siklus dimulai lagi' — apa maksudnya? Akademi bilang murid itu kabur, tapi catatan ini...",
     "choices": [
      {
       "label": "Kita harus memutuskan apa yang dilakukan dengan ini.",
       "condition": {
         "flag": {"key": "flag_lin_yue_privacy_respected", "value": true}
       },
       "next": "n2a"
      },
      {
       "label": "Kita harus memutuskan apa yang dilakukan dengan ini.",
       "condition": {
         "flag": {"key": "flag_lin_yue_secret_known", "value": true}
       },
       "next": "n2b"
      },
      {
       "label": "Kita harus memutuskan apa yang dilakukan dengan ini.",
       "next": "n2c"
      }
     ]
    },
    "n2a": {
     "speaker": "npc:npc_lin_yue",
     "text": "Ya. Apa pun yang kita pilih, ini akan mengubah segalanya. Dan karena kau sudah membuktikan kepercayaanmu, aku akan berdiri di sampingmu — apa pun yang terjadi.",
     "choices": []
    },
    "n2b": {
     "speaker": "npc:npc_lin_yue",
     "text": "Kau sudah tahu bebanku, dan kau tetap di sini. Aku... aku tidak yakin harus berterima kasih atau minta maaf. Tapi aku percaya padamu.",
     "choices": []
    },
    "n2c": {
     "speaker": "npc:npc_lin_yue",
     "text": "Ya. Apa pun yang kita pilih, ini akan mengubah segalanya. Aku percaya padamu.",
     "choices": []
    }
   }
  },
