```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Test cache files
.pytest_cache/

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# Coverage reports
.coverage
htmlcov/
coverage/

# Temporary files
*.tmp
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/

# Dependencies
.venv/
venv/
node_modules/

# IDE files
.vscode/
.idea/

# Compiled files
*.so
*.dylib
*.dll
*.exe
*.out
*.a
*.o
```